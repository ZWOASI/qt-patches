+static bool hasFramelessNativeFrame(bool bFrameless, DWORD nStyle)
+{
+    return bFrameless && !(nStyle & WS_CHILD)
+            && (nStyle & (WS_CAPTION | WS_THICKFRAME)) == (WS_CAPTION | WS_THICKFRAME);
+}
+
+static QMargins framelessMaximizedMargins(UINT nDpi)
+{
+    const int nBorderX = getResizeBorderThickness(nDpi);
+    const int nBorderY = GetSystemMetricsForDpi(SM_CYSIZEFRAME, nDpi)
+            + GetSystemMetricsForDpi(SM_CXPADDEDBORDER, nDpi);
+    return QMargins(nBorderX, nBorderY, nBorderX, nBorderY);
+}
+
+static void updateFramelessFrame(HWND hWnd, bool bEnabled)
+{
+    // 客户区覆盖整个窗口后，保留 DWM 阴影；退出无边框或进入全屏时撤销扩展。
+    const int nExtent = bEnabled ? 1 : 0;
+    const MARGINS margins = {nExtent, nExtent, nExtent, nExtent};
+    DwmExtendFrameIntoClientArea(hWnd, &margins);
+}
+
+static void adjustFramelessMaximizedClientRect(HWND hWnd, RECT *pClientRect)
+{
+    // 最大化的外框会超出工作区，先去掉不可见的缩放边框，不扣除标题栏高度。
+    const QMargins margins = framelessMaximizedMargins(GetDpiForWindow(hWnd));
+    const HMONITOR hMonitor = MonitorFromRect(pClientRect, MONITOR_DEFAULTTONEAREST);
+    pClientRect->left += margins.left();
+    pClientRect->top += margins.top();
+    pClientRect->right -= margins.right();
+    pClientRect->bottom -= margins.bottom();
+
+    MONITORINFO monitorInfo = {};
+    monitorInfo.cbSize = sizeof(monitorInfo);
+    if (!GetMonitorInfo(hMonitor, &monitorInfo))
+        return;
+
+    pClientRect->left = qMax(pClientRect->left, monitorInfo.rcWork.left);
+    pClientRect->top = qMax(pClientRect->top, monitorInfo.rcWork.top);
+    pClientRect->right = qMin(pClientRect->right, monitorInfo.rcWork.right);
+    pClientRect->bottom = qMin(pClientRect->bottom, monitorInfo.rcWork.bottom);
+
+    // 只在最大化时为自动隐藏任务栏保留触发边，真正的全屏仍覆盖整个显示器。
+    const UINT arrEdges[] = {ABE_LEFT, ABE_TOP, ABE_RIGHT, ABE_BOTTOM};
+    for (const UINT nEdge : arrEdges) {
+        APPBARDATA appBarData = {};
+        appBarData.cbSize = sizeof(appBarData);
+        appBarData.uEdge = nEdge;
+        appBarData.rc = monitorInfo.rcMonitor;
+        if (!SHAppBarMessage(ABM_GETAUTOHIDEBAREX, &appBarData))
+            continue;
+        constexpr int nTriggerWidth = 2;
+        switch (nEdge) {
+        case ABE_LEFT:
+            pClientRect->left = qMax(pClientRect->left, monitorInfo.rcMonitor.left + nTriggerWidth);
+            break;
+        case ABE_TOP:
+            pClientRect->top = qMax(pClientRect->top, monitorInfo.rcMonitor.top + nTriggerWidth);
+            break;
+        case ABE_RIGHT:
+            pClientRect->right = qMin(pClientRect->right, monitorInfo.rcMonitor.right - nTriggerWidth);
+            break;
+        case ABE_BOTTOM:
+            pClientRect->bottom = qMin(pClientRect->bottom, monitorInfo.rcMonitor.bottom - nTriggerWidth);
+            break;
+        }
+    }
+}
